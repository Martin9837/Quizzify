# ---------------------------------------------------------------------------
# SalesOS configuration. Every value has a working default in development, so
# `npm install && npm run dev` needs none of this. Set them for production.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:4000
WEB_ORIGINS=http://localhost:5173

# --- security (REQUIRED in production; auto-generated in development) -------
# JWT_SECRET=change-me-to-a-long-random-string
# ENCRYPTION_KEY=change-me-too-used-for-credentials-and-recordings

# --- database ---------------------------------------------------------------
# DATABASE_FILE=./server/data/salesos.db

# --- AI ---------------------------------------------------------------------
# 'auto' uses Anthropic when a key is present, otherwise the built-in engine.
AI_PROVIDER=auto
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
# AI_TIMEOUT_MS=60000

# Optional external speech-to-text endpoint. Without it, simulator calls use the
# built-in synthetic transcript engine.
# STT_URL=https://api.example.com/v1/transcribe
# STT_API_KEY=...

# --- telephony --------------------------------------------------------------
TELEPHONY_PROVIDER=simulator
TELEPHONY_CALLER_ID=+15550100
TELEPHONY_MASKING=true
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_TWIML_APP_SID=

# --- email ------------------------------------------------------------------
EMAIL_PROVIDER=log
EMAIL_FROM_NAME=SalesOS
EMAIL_FROM_ADDRESS=no-reply@salesos.local
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# --- object storage ---------------------------------------------------------
STORAGE_DRIVER=local
# STORAGE_ROOT=./server/data/objects
STORAGE_ENCRYPT_AT_REST=true
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=

# --- background processing --------------------------------------------------
QUEUE_ENABLED=true
QUEUE_CONCURRENCY=3
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=60000

# --- limits and logging -----------------------------------------------------
RATE_LIMIT_MAX=600
RATE_LIMIT_AUTH_MAX=20
LOG_LEVEL=debug
LOG_PRETTY=true

# --- demo data --------------------------------------------------------------
DEMO_PASSWORD=Demo1234!
